APP_NAME="Bracket Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Compose local: usar los valores de id -u / id -g del anfitrión.
LOCAL_UID=1000
LOCAL_GID=1000
# Fedora/Podman: keep-id; Docker: host.
CONTAINER_USERNS=host
APP_PORT=8000
VITE_PORT=5173
